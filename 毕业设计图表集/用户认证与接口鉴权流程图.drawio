        </mxCell>

        <!-- 接口访问控制 -->
        <mxCell id="api_auth" value="携带 Token 访问&#xa;受保护接口" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
