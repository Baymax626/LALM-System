        <mxCell id="line3" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="reg_impl" target="login_verify">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
