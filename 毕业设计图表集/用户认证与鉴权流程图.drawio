<mxfile host="Electron" modified="2026-03-23T10:30:00.000Z" agent="5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/21.3.7 Chrome/112.0.5615.204 Electron/24.5.0 Safari/537.36" etag="auth_flow_final" version="21.3.7" type="device">
  <diagram id="auth_diagram" name="用户认证与鉴权流程图">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 开始 -->
        <mxCell id="start" value="开始" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- 注册/登录选择 -->
        <mxCell id="choice" value="是否已有账号？" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="140" width="160" height="100" as="geometry" />
        </mxCell>

        <!-- 注册实现 -->
        <mxCell id="reg_impl" value="4.1.1 用户注册实现&#xa;(SHA-256 哈希加密)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="120" y="160" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- 登录验证 -->
        <mxCell id="login_verify" value="4.1.1 登录身份验证&#xa;(哈希比对并签发Token)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="280" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- 访问受限接口 -->
        <mxCell id="access_api" value="访问业务接口&#xa;携带 Authorization Token" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="380" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- 拦截器鉴权 -->
        <mxCell id="interceptor" value="4.1.2 拦截器鉴权校验" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="480" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- 成功访问 -->
        <mxCell id="success" value="授权成功&#xa;执行核心业务逻辑" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="620" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- 失败处理 -->
        <mxCell id="fail" value="返回 401 错误&#xa;重定向至登录页" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="580" y="500" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- 结束 -->
        <mxCell id="end" value="结束" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="720" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- 连线 -->
        <mxCell id="line1" value="" style="endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="start" target="choice">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="line2" value="否" style="endArrow=classic;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;" edge="1" parent="1" source="choice" target="reg_impl">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
